{
  "properties": {
    "roleName": "AIOps Monitoring Engineer",
    "description": "ME Team custom role. Allows full lifecycle management of centralized AIOps Action Groups in the ME shared-services subscription, management of Azure Policy definitions and assignments at management group scope, and oversight of metric alert rules. Does NOT grant broad contributor or Owner rights.",
    "assignableScopes": [
      "/providers/Microsoft.Management/managementGroups/mgmt-group-1",
      "/subscriptions/2b73f762-264b-40ac-9ade-a1f95c5b2195"
    ],
    "permissions": [
      {
        "actions": [

          "-----------------------------------------------------------------------",
          "Action Groups - Full lifecycle management in ME subscription",
          "-----------------------------------------------------------------------",
          "Microsoft.Insights/actionGroups/read",
          "Microsoft.Insights/actionGroups/write",
          "Microsoft.Insights/actionGroups/delete",

          "-----------------------------------------------------------------------",
          "Metric Alert Rules - Read and manage (ME team may own some baseline alerts)",
          "-----------------------------------------------------------------------",
          "Microsoft.Insights/metricAlerts/read",
          "Microsoft.Insights/metricAlerts/write",
          "Microsoft.Insights/metricAlerts/delete",
          "Microsoft.Insights/metricAlerts/status/read",

          "-----------------------------------------------------------------------",
          "Azure Policy - Manage definitions and assignments at Management Group scope",
          "-----------------------------------------------------------------------",
          "Microsoft.Authorization/policyDefinitions/read",
          "Microsoft.Authorization/policyDefinitions/write",
          "Microsoft.Authorization/policyDefinitions/delete",
          "Microsoft.Authorization/policySetDefinitions/read",
          "Microsoft.Authorization/policySetDefinitions/write",
          "Microsoft.Authorization/policySetDefinitions/delete",
          "Microsoft.Authorization/policyAssignments/read",
          "Microsoft.Authorization/policyAssignments/write",
          "Microsoft.Authorization/policyAssignments/delete",
          "Microsoft.Authorization/policyExemptions/read",
          "Microsoft.Authorization/policyExemptions/write",
          "Microsoft.Authorization/policyExemptions/delete",
          "Microsoft.PolicyInsights/policyStates/read",
          "Microsoft.PolicyInsights/policyEvents/queryResults/read",
          "Microsoft.PolicyInsights/policyMetadata/read",
          "Microsoft.PolicyInsights/remediations/read",
          "Microsoft.PolicyInsights/remediations/write",
          "Microsoft.PolicyInsights/remediations/delete",
          "Microsoft.PolicyInsights/remediations/cancel/action",

          "-----------------------------------------------------------------------",
          "Resource and subscription read access (required to scope policies and view resources)",
          "-----------------------------------------------------------------------",
          "Microsoft.Resources/subscriptions/read",
          "Microsoft.Resources/subscriptions/resourceGroups/read",
          "Microsoft.Resources/subscriptions/resourceGroups/resources/read",
          "Microsoft.Management/managementGroups/read",
          "Microsoft.Management/managementGroups/subscriptions/read",

          "-----------------------------------------------------------------------",
          "Metrics and diagnostics - read-only visibility across managed resources",
          "-----------------------------------------------------------------------",
          "Microsoft.Insights/metrics/read",
          "Microsoft.Insights/metricDefinitions/read",
          "Microsoft.Insights/diagnosticSettings/read",
          "Microsoft.Insights/alertRules/read",
          "Microsoft.Insights/activityLogAlerts/read"

        ],
        "notActions": [],
        "dataActions": [],
        "notDataActions": []
      }
    ]
  },
  "_comment": {
    "usage": "Assign this role to the ME team at the ME shared-services subscription and/or the management group where AIOps policies are managed.",
    "important": "Replace <ME-MANAGEMENT-GROUP-ID> and <ME-SHARED-SERVICES-SUBSCRIPTION-ID> before deployment.",
    "policyNote": "For policy definition/assignment permissions to work at management group scope, the role must be assigned at that management group. Subscription-scope assignment only allows policy management within that subscription.",
    "deploymentNote": "To deploy this role via Azure CLI: az role definition create --role-definition @AIOps-ME-MonitoringEngineer-Role.json"
  }
}
