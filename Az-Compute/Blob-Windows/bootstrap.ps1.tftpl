$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$labPath = 'C:\ProgramData\AdlsLab'
$downloadPath = Join-Path $labPath 'azcopy.zip'
$extractPath = Join-Path $labPath 'extract'
New-Item -ItemType Directory -Force -Path $labPath, 'C:\adls-out', 'C:\adls-in' | Out-Null

Invoke-WebRequest -Uri 'https://aka.ms/downloadazcopy-v10-windows' -OutFile $downloadPath -UseBasicParsing
Expand-Archive -Path $downloadPath -DestinationPath $extractPath -Force
$executables = @(Get-ChildItem -Path $extractPath -Filter 'azcopy.exe' -Recurse -File)
if ($executables.Count -ne 1) {
    throw "Expected one AzCopy executable, found $($executables.Count)."
}
Copy-Item -Path $executables[0].FullName -Destination (Join-Path $labPath 'azcopy.exe') -Force
Remove-Item -Path $downloadPath, $extractPath -Recurse -Force

$scriptBytes = [Convert]::FromBase64String('${copy_script}')
[IO.File]::WriteAllBytes((Join-Path $labPath 'copy.ps1'), $scriptBytes)
$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "C:\ProgramData\AdlsLab\copy.ps1"'
$trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(5) -RepetitionInterval (New-TimeSpan -Hours 1) -RepetitionDuration (New-TimeSpan -Days 1)
$trigger.Repetition.Duration = $null
$principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
$settings = New-ScheduledTaskSettingsSet -MultipleInstances IgnoreNew -StartWhenAvailable
Register-ScheduledTask -TaskName 'AdlsLabCopy' -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force | Out-Null
